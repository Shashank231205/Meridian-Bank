# ---------------------------------------------------------------------------
# Secrets — NEVER commit. Only .env.example is tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json

# ---------------------------------------------------------------------------
# Data — regenerated by the pipeline; large and/or externally sourced.
# Directory skeleton is preserved via .gitkeep files.
# ---------------------------------------------------------------------------
data/**
!data/**/
!data/**/.gitkeep

outputs/**
!outputs/**/
!outputs/**/.gitkeep

logs/**
!logs/.gitkeep

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
.Python
build/
develop-eggs/
dist/
eggs/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Environments
.venv/
venv/
env/
ENV/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------------------------------------------------------------------------
# Databases (regenerated by the warehouse loader)
# ---------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
