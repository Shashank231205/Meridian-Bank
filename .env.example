# ---------------------------------------------------------------------------
# Meridian Bank — environment template
#
#   cp .env.example .env      then fill in the values you need.
#   .env is gitignored and must NEVER be committed.
#
# The pipeline runs end-to-end with NO keys at all: every data source used by
# the core build (World Bank, FDIC, UCI, Frankfurter, ECB) is key-free.
# Everything below is optional enrichment.
# ---------------------------------------------------------------------------

# --- LLM narrative layer ---------------------------------------------------
# Narrative is generated at BUILD time and written to a static JSON file, so
# the deployed dashboard never calls an LLM at runtime.
#
# LLM_PROVIDER: "ollama" (local, default) | "groq" (cloud) | "none" (skip)
LLM_PROVIDER=ollama

# Ollama — local, no key, no rate limit. Customer-grain data never leaves the
# machine. Start with: ollama serve
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Groq — free tier, no credit card. https://console.groq.com/keys
# NOTE: free LLM tiers may train on submitted prompts. The client sends
# AGGREGATE KPIs ONLY — never customer-level rows. See docs/RISK_ASSESSMENT.md
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional enrichment sources (all have free tiers) ---------------------
# FRED — https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# data.gov.in — https://data.gov.in/ (India Open Government Data)
DATA_GOV_IN_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key  (25 req/day)
ALPHA_VANTAGE_API_KEY=

# Finnhub — https://finnhub.io/register  (60 req/min)
FINNHUB_API_KEY=

# --- Pipeline behaviour ----------------------------------------------------
# Master seed. Fixed seed => byte-identical synthetic data across runs.
MERIDIAN_SEED=20260911

# Synthetic customer count (25000 default; lower for fast local iteration)
MERIDIAN_N_CUSTOMERS=25000

# HTTP cache TTL in days. Raw API payloads are cached to data/raw/ so the
# pipeline is fully rerunnable offline after the first fetch.
HTTP_CACHE_TTL_DAYS=7

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
